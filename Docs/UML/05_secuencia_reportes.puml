@startuml
title Generar reportes de gestión
actor Administrador as A
participant MenuConsola as Vista
participant ControladorReportes as C
participant Barrio as B
participant Lote as L
participant Reclamo as R
participant Equipo as E
participant FilaMorosidad as F
A -> Vista : seleccionar reporte y filtros
alt reclamos pendientes
 Vista -> C : reclamosPendientes(desde, hasta, tipo)
 C -> B : obtenerReclamos()
 B --> C : lista
 loop por reclamo
  C -> R : estaPendiente()
  R --> C : boolean
  opt pendiente y pasa filtros
   C -> C : agregar al resultado
  end
 end
 C --> Vista : List<Reclamo>
else morosidad
 Vista -> C : morosidadPorLote(hasta)
 C -> B : obtenerLotes()
 B --> C : lista
 loop por lote
  C -> L : cantidadPeriodosImpagos(hasta)
  L --> C : cantidad
  opt cantidad > 3
   C -> L : calcularDeudaCapital()
   L --> C : capital
   C -> L : calcularDeudaIntereses(hasta)
   L --> C : intereses
   create F
   C -> F : new FilaMorosidad(lote, cantidad, capital, intereses)
  end
 end
 C --> Vista : List<FilaMorosidad>
else equipos fuera de servicio
 Vista -> C : equiposFueraDeServicio(sector)
 C -> B : obtenerEquipos()
 B --> C : lista
 loop por equipo
  C -> E : estaFueraDeServicio()
  E --> C : boolean
  opt fuera de servicio y pasa filtro
   C -> C : agregar al resultado
  end
 end
 C --> Vista : List<Equipo>
end
Vista --> A : mostrar resultados
@enduml
