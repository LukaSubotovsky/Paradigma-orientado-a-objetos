@startuml
title Los Aromos - clases implementadas (vista general)
left to right direction
skinparam classAttributeIconSize 0
package Modelo {
 class Barrio
 class Lote
 class Persona
 class Administrador
 abstract class Personal
 class GuardiaDeSeguridad
 class EmpleadoDeMantenimiento
 class VinculoLote
 class Reclamo
 class GestionReclamos
 class Expensa
 class Pago
 class GestionExpensas
 abstract class Equipo
 class Camara
 class Luminaria
 class GestionEquipos
 class Autorizacion
 class RegistroAcceso
 class GestionVisitas
 class Usuario
 class Sesion
}
package Controlador {
 class ControladorDatos
 class ControladorReclamos
 class ControladorExpensas
 class ControladorEquipos
 class ControladorVisitas
 class ControladorReportes
}
package Vista { class MenuConsola }
package Persistencia { class ArchivoBarrio }
Barrio "1" *-- "0..150" Lote
Barrio "1" o-- "0..*" Equipo
Barrio "1" o-- "0..*" Reclamo
Barrio "1" o-- "0..*" Autorizacion
Lote "1" *-- "1..*" VinculoLote
Lote "1" *-- "0..*" Expensa
Lote "1" *-- "0..*" Pago
VinculoLote "*" --> "1" Persona
Persona <|-- Administrador
Personal <|-- GuardiaDeSeguridad
Personal <|-- EmpleadoDeMantenimiento
Equipo <|-- Camara
Equipo <|-- Luminaria
Reclamo "*" --> "1" Personal : responsable opcional
Autorizacion "1" *-- "0..*" RegistroAcceso
ControladorReclamos --> GestionReclamos
ControladorExpensas --> GestionExpensas
ControladorEquipos --> GestionEquipos
ControladorVisitas --> GestionVisitas
ControladorReportes --> Barrio
ControladorDatos --> Barrio
MenuConsola --> ControladorReclamos
MenuConsola --> ControladorExpensas
MenuConsola --> ControladorEquipos
MenuConsola --> ControladorVisitas
MenuConsola --> ControladorReportes
MenuConsola --> ArchivoBarrio
Sesion --> Usuario
@enduml
