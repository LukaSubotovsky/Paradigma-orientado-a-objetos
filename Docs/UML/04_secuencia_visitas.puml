@startuml
skinparam classAttributeIconSize 0
title Registrar ingreso y egreso de una visita
actor "Guardia de seguridad" as G
participant ControladorVisitas as C
participant Autorizacion as A
participant RegistroAcceso as R
G -> C : consultarAutorizacion(documento, fecha, hora)
C -> A : estaVigente(fecha, hora)
A --> C : vigente
alt autorización vencida o inexistente
 C --> G : denegarIngreso(motivo)
else autorización vigente
 C -> A : permiteIngreso()
 A --> C : permitido
 alt persona ya está dentro
  C --> G : denegarIngreso("egreso pendiente")
 else autorización no habilita esta visita
  C --> G : denegarIngreso("fuera de franja o límite")
 else ingreso habilitado
  G -> C : registrarIngreso(autorizacion, guardia)
  create R
  C -> R : RegistroAcceso(horaIngreso, guardia)
  C --> G : ingreso registrado(registro)
  G -> C : registrarEgreso(registro)
  C -> R : registrarEgreso(hora)
  R --> C : egreso registrado
  C --> G : egreso confirmado
 end
end
@enduml
